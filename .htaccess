# epanet-plus-plus.org -- the document root IS this repository.
#
# NO `Options` LINE, DELIBERATELY. An Options directive where AllowOverride Options is not granted
# returns 500 for EVERY request on the host. Everything below is mod_alias, as on LibreWaterNet.org,
# which runs on the same cPanel account.
#
# Every path with a directory segment beginning with a dot (.git above all) is a 404. <FilesMatch>
# would not cover it: it matches file NAMES, and .git/config is not itself a dotfile.
RedirectMatch 404 "/\.(?!well-known/)[^/]+/"
#
# The build tooling and the working notes are not visitor material. tools/ is declared "deny" in
# check.sh; a new directory must be declared there too, or check.sh fails.
RedirectMatch 404 "^/tools(/|$)"
RedirectMatch 404 "\.(md|sh|py)$"
#
# B1, RELEASED 2026-09-28 on Tom's "Release": the map app is served here at /app/, from the
# ./engcalcs symlink into the suite (same target as librewaternet.org's). /app redirects to /app/ first:
# a web app manifest's scope is a plain string prefix, so a visitor at the bare /app could not install.
# Never add a redirect on /engcalcs/Looped-Network.php here; that loops (the PHP does it).
RewriteEngine On
RewriteRule ^app$ /app/ [R=301,L]
RewriteRule ^app/?$ /engcalcs/Looped-Network.php [L]
#
# THE BLOCK BELOW IS cPANEL'S AND IT IS LOAD-BEARING. Setting this vhost's PHP version in MultiPHP
# Manager writes it here, and it is how ea-php83 reaches the app; without it the account default
# (ea-php56) 500s every app page. It is carried in this tracked file so that cPanel's write and ours
# agree and a pull does not conflict. Leave it alone; cPanel rewrites it when the version changes.

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
